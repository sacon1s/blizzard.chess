{
  "rules": {
    "users": {
      ".read": true,
      ".indexOn": ["ratings/bullet", "ratings/blitz", "ratings/rapid", "ratings/classical"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'ratings'])",
        "name": {
          ".validate": "newData.isString() && root.child('names').child(newData.val().toLowerCase()).val() === $uid"
        },
        "created": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "ratings": {
          "$sp": {
            ".validate": "($sp === 'bullet' || $sp === 'blitz' || $sp === 'rapid' || $sp === 'classical') && newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000 && (!data.exists() ? newData.val() === 1200 : (newData.val() === data.val() || (newData.val() - data.val() <= 40 && data.val() - newData.val() <= 40 && newData.parent().parent().child('games').child($sp).val() === (data.parent().parent().child('games').child($sp).exists() ? data.parent().parent().child('games').child($sp).val() : 0) + 1)))"
          }
        },
        "games": {
          "$sp": {
            ".validate": "newData.isNumber() && (!data.exists() ? newData.val() <= 1 : (newData.val() === data.val() || newData.val() === data.val() + 1))"
          }
        },
        "wins": {
          ".validate": "newData.isNumber() && (!data.exists() ? newData.val() <= 1 : (newData.val() === data.val() || newData.val() === data.val() + 1))"
        },
        "draws": {
          ".validate": "newData.isNumber() && (!data.exists() ? newData.val() <= 1 : (newData.val() === data.val() || newData.val() === data.val() + 1))"
        },
        "losses": {
          ".validate": "newData.isNumber() && (!data.exists() ? newData.val() <= 1 : (newData.val() === data.val() || newData.val() === data.val() + 1))"
        },
        "puzzle": {
          ".validate": "newData.hasChildren(['rating']) && newData.child('rating').isNumber() && newData.child('rating').val() >= 100 && newData.child('rating').val() <= 4000"
        },
        "rush": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
        },
        "ach": {
          "$id": { ".validate": "newData.isNumber()" }
        },
        "hist": {
          "$sp": {
            "$k": { ".validate": "newData.hasChildren(['r', 't']) && newData.child('r').isNumber() && newData.child('t').isNumber()" }
          }
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length < 60000 && newData.val().beginsWith('data:image/')"
        },
        "about": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z][a-z]$/)"
        }
      }
    },
    "names": {
      ".read": true,
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid",
        ".validate": "$name.matches(/^[a-z0-9_-]{3,20}$/)"
      }
    },
    "online": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    },
    "seeks": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null",
        "$uid": {
          ".validate": "newData.hasChildren(['name', 'rating', 't']) && newData.child('name').isString() && newData.child('rating').isNumber() && (data.exists() || $uid === auth.uid)"
        }
      }
    },
    "matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (newData.isString() && ((root.child('games').child(newData.val()).child('white').val() === $uid && root.child('games').child(newData.val()).child('black').val() === auth.uid) || (root.child('games').child(newData.val()).child('black').val() === $uid && root.child('games').child(newData.val()).child('white').val() === auth.uid))))"
      }
    },
    "games": {
      ".read": true,
      ".indexOn": ["status"],
      "$gid": {
        ".write": "auth != null && newData.exists() && (data.exists() ? (data.child('white').val() === auth.uid || data.child('black').val() === auth.uid || data.child('status').val() === 'open') : (newData.child('white').val() === auth.uid || newData.child('black').val() === auth.uid))",
        ".validate": "newData.hasChildren(['tc', 'status', 'clock']) && (!data.child('white').exists() || newData.child('white').val() === data.child('white').val()) && (!data.child('black').exists() || newData.child('black').val() === data.child('black').val()) && (!data.child('result').exists() || newData.child('result').val() === data.child('result').val())",
        "white": {
          ".validate": "newData.isString() && (data.exists() || newData.val() === auth.uid || !data.parent().exists())"
        },
        "black": {
          ".validate": "newData.isString() && (data.exists() || newData.val() === auth.uid || !data.parent().exists())"
        },
        "host": {
          ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === auth.uid"
        },
        "tc": { ".validate": "newData.isString() && newData.val().length <= 12 && (!data.exists() || newData.val() === data.val())" },
        "base": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "inc": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "speed": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "rated": { ".validate": "newData.isBoolean() && (!data.exists() || newData.val() === data.val())" },
        "daily": { ".validate": "newData.isBoolean() && (!data.exists() || newData.val() === data.val())" },
        "arena": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "fen": { ".validate": "newData.isString() && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())" },
        "status": {
          ".validate": "newData.isString() && (data.exists() ? (newData.val() === data.val() || (data.val() === 'open' && (newData.val() === 'started' || newData.val() === 'aborted')) || (data.val() === 'started' && (newData.val() === 'over' || newData.val() === 'aborted'))) : (newData.val() === 'open' || newData.val() === 'started'))"
        },
        "result": {
          ".validate": "newData.val() === '1-0' || newData.val() === '0-1' || newData.val() === '1/2-1/2'"
        },
        "reason": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "moves": {
          ".validate": "newData.isString() && newData.val().length <= 5000 && (!data.exists() || newData.val().beginsWith(data.val()))"
        },
        "clock": {
          ".validate": "newData.hasChildren(['w', 'b', 'last'])"
        },
        "settled": {
          "$u": {
            ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : ($u === auth.uid && newData.val() <= 40 && newData.val() >= -40))"
          }
        },
        "left": {
          "$u": { ".validate": "newData.isNumber()" }
        },
        "drawOffer": {
          ".validate": "newData.isString() && ((data.exists() && newData.val() === data.val()) || newData.val() === auth.uid)"
        },
        "rematch": {
          ".validate": "newData.hasChildren(['gid', 'by']) && (data.exists() ? (newData.child('gid').val() === data.child('gid').val() && newData.child('by').val() === data.child('by').val()) : newData.child('by').val() === auth.uid)"
        },
        "chat": {
          "$m": {
            ".validate": "newData.hasChildren(['u', 'm']) && newData.child('m').isString() && newData.child('m').val().length <= 200 && (data.exists() ? (newData.child('u').val() === data.child('u').val() && newData.child('m').val() === data.child('m').val()) : newData.child('u').val() === auth.uid)"
          }
        }
      }
    },
    "userGames": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["date"]
      }
    },
    "friends": {
      "$uid": {
        ".read": true,
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $other && (!newData.exists() || root.child('friendRequests').child(auth.uid).child($uid).exists())))",
          ".validate": "newData.hasChildren(['name', 'since']) && $other !== $uid"
        }
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && (auth.uid === $from || auth.uid === $to)",
          ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 't']) && $from !== $to"
        }
      }
    },
    "challenges": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$gid": {
          ".read": "auth != null && data.child('from').val() === auth.uid",
          ".write": "auth != null && (newData.exists() ? (newData.child('from').val() === auth.uid && root.child('games').child($gid).child('host').val() === auth.uid) : (auth.uid === $to || data.child('from').val() === auth.uid))",
          ".validate": "newData.hasChildren(['from', 'name', 'tc', 't'])"
        }
      }
    },
    "arenas": {
      ".read": true,
      "$aid": {
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $aid.matches(/^(blitz|bullet)-[0-9]{10}$/)",
            ".validate": "newData.hasChildren(['name', 'score', 'games'])",
            "score": {
              ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || (newData.val() > data.val() && newData.val() <= data.val() + 4 && newData.parent().child('games').val() === data.parent().child('games').val() + 1)))"
            },
            "games": {
              ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() || newData.val() === data.val() + 1))"
            }
          }
        }
      }
    }
  }
}
